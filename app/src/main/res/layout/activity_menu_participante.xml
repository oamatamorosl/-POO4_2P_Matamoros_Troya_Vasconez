<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/lblNombreParticipante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/lblTipoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnTablaPosiciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tabla de posiciones"
        android:onClick="irTablaPosiciones"/>

    <Button
        android:id="@+id/btnPronosticos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pronósticos"
        android:onClick="irPronosticos"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnMisPronosticos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis pronósticos"
        android:onClick="irMisPronosticos"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/btnSalir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Salir"
        android:onClick="salir"
        android:layout_marginTop="24dp"/>

</LinearLayout>