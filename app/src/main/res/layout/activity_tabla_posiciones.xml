<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fondo único para toda la pantalla (solo se ve detrás del header) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_menu"
        android:scaleType="centerCrop"
        android:contentDescription="Fondo pantalla"/>

    <!-- Contenido encima del fondo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: mismo diseño que el menú -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_usuario"
                android:contentDescription="Avatar"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido,"
                    android:textSize="12sp"
                    android:textColor="@color/gris_texto_claro"/>

                <TextView
                    android:id="@+id/lblNombreParticipante"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/ic_trofeo_blanco"
                android:contentDescription="Mundial 2026"/>

        </LinearLayout>

        <!-- Todo lo de abajo: fondo blanco sólido, NO transparente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/caja_blanca_arriba"
            android:padding="20dp">

            <!-- Encabezado de la sección -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_trofeo"
                    android:contentDescription="Trofeo"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tabla de posiciones"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="@color/azul_marino_oscuro"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Así van los participantes del Mundial 2026"
                        android:textSize="12sp"
                        android:textColor="@color/gris_texto_claro"/>

                </LinearLayout>
            </LinearLayout>

            <!-- Tabla -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/caja_blanca">

                <TableLayout
                    android:id="@+id/tablaLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="0,1,2"/>

            </ScrollView>

            <!-- Botón Volver -->
            <TextView
                android:id="@+id/btnVolver"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="←  Volver"
                android:onClick="volver"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/caja_blanca"
                android:textColor="@color/azul_marino_oscuro"
                android:textStyle="bold"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:layout_marginTop="16dp"/>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
